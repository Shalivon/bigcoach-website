# Supabase (leads land in the `leads` table — see supabase/schema.sql).
# Leave empty to skip Supabase; leads are still logged and forwarded to webhooks.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional webhook forwarding (same behavior as the previous site/api/lead.js)
GOOGLE_SHEETS_WEBHOOK_URL=
CRM_WEBHOOK_URL=
